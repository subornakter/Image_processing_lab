import cv2
import numpy as np

filename = input("Enter image path: ")

image = cv2.imread(filename, cv2.IMREAD_UNCHANGED)

if image is None:
    print("Image could not be loaded.")
    exit()

print("Image shape:", image.shape)

# Grayscale image
if len(image.shape) == 2:

    unique_values = np.unique(image)

    if len(unique_values) == 2:
        print("Binary Image")
        print("Reason: detected",
              len(unique_values),
              "unique pixel values.")
    else:
        print("Grayscale Image")
        print("Reason: single-channel image with",
              len(unique_values),
              "unique intensity values.")

# Color image
else:
    print("Full-Color Image")
    print("Reason: detected",
          image.shape[2],
          "channels.")
